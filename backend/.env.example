APP_NAME=Daily News Hub
DEBUG=True
DATABASE_URL=postgresql+asyncpg://localhost:5432/dailynewshub
DATABASE_V2_URL=postgresql+asyncpg://localhost:5432/dailynewshub_nms
# --- SEC FIX SEC-002 ---
SECRET_KEY=generate-a-strong-64-character-hex-secret-before-running
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CURRENTS_API_KEY=your-currents-api-key
CURRENTS_API_URL=https://api.currentsapi.services/v1
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json
# --- SEC FIX SEC-013 ---
# Paste the entire firebase-credentials.json content as a single JSON string.
# Generate with: cat firebase-credentials.json | python3 -c "import sys,json; print(json.dumps(json.load(sys.stdin)))"
FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"your-project","private_key_id":"replace-me","private_key":"-----BEGIN PRIVATE KEY-----\\nreplace-me\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk@example.iam.gserviceaccount.com","client_id":"replace-me","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk%40example.iam.gserviceaccount.com","universe_domain":"googleapis.com"}
# --- DOCKER FIX ---
REDIS_PASSWORD=generate-a-strong-password-here
# --- DOCKER FIX ---
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/1
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/2
UPLOADS_DIR=uploads

# --- NEW ADDITION ---
YOUTUBE_API_KEY=your-youtube-api-key
YOUTUBE_NEWS_CHANNEL_IDS=UC123,UC456
GROQ_API_KEY=your-groq-api-key
GOOGLE_TTS_API_KEY=your-google-tts-api-key
FRONTEND_URL=https://dailynewshub.app
# --- SEC FIX SEC-007 ---
ADMIN_DASH_URL=http://localhost:3000
# --- SEC FIX SEC-008 ---
ENVIRONMENT=development
# In production .env set: ENVIRONMENT=production
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# --- SEC FIX SEC-002 ---
DEVELOPER_SECRET_KEY=generate-a-different-strong-64-character-hex-secret-before-running
DEVELOPER_ACCESS_TOKEN_EXPIRE_MINUTES=60
DEVELOPER_REFRESH_TOKEN_EXPIRE_DAYS=30
